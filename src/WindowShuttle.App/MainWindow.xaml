<ui:FluentWindow x:Class="WindowShuttle.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WindowShuttle.App.I18n"
        xmlns:app="clr-namespace:WindowShuttle.App"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{loc:Loc App_Name}"
        Width="{x:Static app:MainWindow.DefaultWidthDip}"
        Height="{x:Static app:MainWindow.DefaultHeightDip}"
        MinWidth="{x:Static app:MainWindow.MinWidthDip}"
        MinHeight="{x:Static app:MainWindow.MinHeightDip}"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None">
    <!-- §window-bounds MinWidth/MinHeight 降到能塞进 1366×768@100%（工作区 1366×728 DIP）以下还有
         富余。真正的起手尺寸/位置由 MainWindow.xaml.cs 的 ApplyStartupBounds 在 OnSourceInitialized
         里用物理像素直接算、直接 SetWindowPos——这两个 Width/Height 只是设计态占位值，跑起来那一刻
         就被物理像素矩形盖过去了。 -->

    <!-- ══ 布局的核心决定：三段高度各有各的来路，不让两段抢同一份 `*` ═══════════════════════
         上一版把地图和动作表都设成 `*`，结果 720px 高的窗口里两边同时输：地图被压到 103px
         （卡片上的"2560 × 1440"被截成"2560 × 1"、窗口条目裁掉半行），动作表 7 条只露出 2 条
         还挂着滚动条，中间却空着一大片。这不是配色问题，是行定义的问题。

         现在：地图带的高度由桌面自己的长宽比算出来（MainWindow.Map.cs 的 DrawMonitors），夹在
         [140,210] 且不超过窗口高度的 28%——一排三屏的桌面得到矮带，上下错位的得到高带，跟真实
         桌面同形。动作区吃掉剩下的全部，七张卡片在可用宽度 ≥760 DIP 时排两列四行，默认尺寸下
         不出滚动条。设置条 Auto 钉底。

         这两块的高度是同一份余额的两头：第一版给地图 34%，动作区就只剩一张半卡片，等于把原来的
         失衡原样翻了个面。任何一头的数字改了，都要回头把另一头实测一遍。 -->
    <!-- RootSurface 不是多余的一层包装。FluentWindow 的模板自己画背景，用的是 WPF-UI 主题里的
         ApplicationBackground 资源，Window.Background 设了也不上屏——实测真机深色下窗口底是
         #202020（WPF-UI 的中性灰），而不是 AppTheme.Room 的 #0B0C11。后果不只是色偏：卡片 Panel
         #20242F 压在 #202020 上只有 1.07:1，几乎分不出面，而上一轮按 Room 解出来并写进断言的
         1.26:1 量的是一个屏幕上根本不存在的颜色。这一层把地真正交回 AppTheme。 -->
    <Border x:Name="RootSurface">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 项目仓库落在标题栏里，不在内容区。它是参考资料而不是操作，分量到此为止；而标题栏是
                 窗口边框的一部分，**不占内容区一分一毫的宽度和高度**，也就永远不会跟别的东西抢地方。
                 这一点是买来的：它先前待在底部说明行的右端，窗口一宽就变成"一句话和一个图标隔着上千
                 像素对望"；试着并到语言选择旁边，又从设置条右侧多吃了 32px，760×480 那档复选框因此
                 多折一行，动作区被挤到只剩 58px、第一张动作卡整个消失（MainWindowCompactLayoutTests
                 当场变红）。两次都是同一个根因：那条带子的宽度是有主的。 -->
            <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{loc:Loc App_Name}">
                <ui:TitleBar.TrailingContent>
                    <!-- 跟最小化/最大化/关闭那三个**对平**。不能直接 VerticalAlignment=Center：标题栏
                         整条比按钮高（标题文字在它的正中），而那三个按钮是贴着顶边的一条 32 高的带子，
                         居中会落到它们下面约 8px（实测图标中心 y≈24，三个字形中心 y≈15.5）。
                         所以自己造一条同高的带子、在里面居中——写的是"跟它们同一条带子"这个意图，
                         而不是一个来路不明的偏移量。 -->
                    <Grid Height="32" VerticalAlignment="Top">
                        <Button x:Name="RepoButton" Click="OnOpenRepo"
                                Width="18" Height="18" MinWidth="0" MinHeight="0" Padding="0"
                                Margin="0,0,10,0" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" VerticalAlignment="Center" Focusable="True"
                                ToolTip="{x:Static app:MainWindow.RepoUrl}"
                                AutomationProperties.Name="GitHub"/>
                    </Grid>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <DockPanel Grid.Row="1" Margin="24,6,24,0" LastChildFill="True">

                <!-- ══ 显示器布局 ══════════════════════════════════════════════════ -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock x:Name="MonitorsTitle" Text="{loc:Loc Main_Monitors}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <ui:Button Content="{loc:Loc Main_Refresh}" Appearance="Secondary" Click="OnRefresh" DockPanel.Dock="Right"
                            FontSize="12" Padding="12,4" VerticalAlignment="Center"/>
                    <!-- 「屏幕序号」不是搬窗动作（SwapPlanner.Plan 对它直接抛），它是这张图的校验工具：
                         图上印的号跟你桌上的实际摆位对不对得上，只有把号闪到真实屏幕上才验得了。
                         所以它待在图旁边，而不是占着动作列表里的一行和两个键位。 -->
                    <ui:Button x:Name="IdentifyButton" Content="{loc:Loc Action_Identify}" Appearance="Secondary"
                            Click="OnIdentify" DockPanel.Dock="Right" FontSize="12" Padding="12,4"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MonitorsHint" Text="{loc:Loc Main_Monitors_Hint}" FontSize="12"
                               Margin="12,2,16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <!-- 地图带：高度由 DrawMonitors 按真实桌面长宽比算出来写进 Height。MinHeight 不是装饰，
                     是保底——Canvas 不度量子元素，没人给它高度时它的 DesiredSize 就是 0，而 DrawMonitors
                     要等 Loaded/SizeChanged 才跑得到。让"这条带子有多高"完全依赖一个事件副作用，就是
                     上一版那个 bug 的同一类问题；MinHeight 把下限交回布局系统，事件只负责把它精确化。

                     这个数必须跟 MainWindow.Map.cs 的 MapFloorWhenCrowded 一致，不是 MapMinHeight。
                     两者的分工：MapMinHeight(140) 是"正常情况下想要多矮为止"，由代码在算 want 时用；
                     这里的 MinHeight 是布局系统的**硬**下限，写多少，Height 就再也小不过多少。曾经这里
                     写的是 140，于是窗口一矮、代码算出该让位给动作卡的 113 被布局系统直接顶回 140——
                     让位逻辑写了等于没写，动作区在 760×480 下依旧一张卡都露不出来。 -->
                <!-- MinHeight 直接引 MapFloorWhenCrowded，不再手抄一份数字：两处曾经各写一个 88，
                     而它们必须相等——XAML 这个是布局系统的硬下限，代码那个是让位算法的目标下限，
                     哪一处先改，另一处就会静默把让位逻辑顶回去。 -->
                <!-- FlowDirection 钉死 LeftToRight：这块画布不是文字，是显示器在桌面上的实物摆位图。
                     RTL 语言（阿拉伯语）下整扇窗镜像是对的，但把这张图也镜像了就是错的——Canvas.SetLeft
                     在 RTL 下从右边缘量起，实测三屏「2 1 3」会画成「3 1 2」，屏 3 明明在用户右手边却
                     画在左边，拖放的落点跟着一起反。卡片里的「2560 × 1440」同样被 bidi 翻成「1440 × 2560」。
                     地图要跟人的脖子转向一致，不跟阅读方向走。 -->
                <Canvas x:Name="LayoutCanvas" DockPanel.Dock="Top"
                        MinHeight="{x:Static app:MainWindow.MapFloorWhenCrowded}"
                        FlowDirection="LeftToRight"
                        SizeChanged="OnCanvasSized" ClipToBounds="True"/>

                <TextBlock x:Name="DropHint" DockPanel.Dock="Top" Margin="1,8,1,0" Text="{loc:Loc Main_DropHint}"
                           FontSize="11.5"/>

                <!-- ══ 设置条 ══════════════════════════════════════════════════════
                     Dock=Bottom 但源码顺序在填充元素之前——DockPanel 的 fill 规则要求"填满剩余空间"的
                     子元素是集合里最后一个且不设 Dock，那个位置留给下面的动作表。Dock 方向和源码顺序
                     是两回事，视觉上这条仍然钉在最底部。 -->
                <Border x:Name="FooterBorder" DockPanel.Dock="Bottom" Margin="-24,14,-24,0" Padding="24,11,24,12"
                        BorderThickness="0,1,0,0">
                    <!-- 内部可滚，配合代码里那条 MaxHeight（FooterMaxShare）。矮窗口下五个复选框在
                         德语/俄语这类长文案里要排四行，设置栏能吃掉窗口高度的 40%，而它是次要的配置面：
                         翻一两行是正常交互，动作区一张卡都露不出来才是主功能面直接消失。窗口够高时
                         MaxHeight 不生效，Auto 也就不会画出滚动条。 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LangLabel" Text="{loc:Loc Settings_Language}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="LangBox" SelectionChanged="OnLangChanged" MinWidth="124" FontSize="12"/>
                            </StackPanel>
                            <!-- ui:Card 包着语言下拉那一版被拆掉了：一个卡片框住一个下拉框，等于给三个
                                 复选框里最不常改的那一项加了一圈额外的视觉重量，读起来像它更重要。

                                 WrapPanel 不是 StackPanel：横排 StackPanel 不认它被分到多少宽度，放不下
                                 就直接溢出去压在右边的语言选择上——英文比中文长得多，实测就是"Start with
                                 Windows"被"Language"压掉半截。WrapPanel 在同样的宽度里换行。 -->
                            <!-- 负左边距是对齐用的，不是手感调整：WPF-UI 的 CheckBox 在方框左边还有一段
                                 自带内边距，于是这一排方框的左边缘落在 x=35，而同一栏里的动作卡和下面那句
                                 说明都在 x=24（页面边距）——三块内容里唯独这一排往里缩了 11px。实测量出来
                                 的就是这 11。它只让**可点区域**多探进边距 11px，那片本来就是空白。 -->
                            <WrapPanel VerticalAlignment="Center" Margin="-11,0,0,0">
                                <CheckBox x:Name="SkipFsBox" Content="{loc:Loc Settings_SkipFullscreen}" Margin="0,2,22,2"
                                          Checked="OnToggle" Unchecked="OnToggle"/>
                                <CheckBox x:Name="RescueBox" Content="{loc:Loc Settings_RescueOnDisplayChange}" Margin="0,2,22,2"
                                          Checked="OnToggle" Unchecked="OnToggle"/>
                                <CheckBox x:Name="TrayBox" Content="{loc:Loc Settings_CloseToTray}" Margin="0,2,22,2"
                                          Checked="OnToggle" Unchecked="OnToggle"/>
                                <!-- 这两格是**一组**，所以在布局上也必须是一个整体：外面那个 WrapPanel
                                     把每个子元素当成可独立换行的单位，把三样东西平铺进去的话，换行会正好
                                     断在中间——实测 760 宽的德语下就是这样：竖线孤零零挂在上一行末尾，
                                     「以管理员身份」掉到下一行，那条线于是从"分组"变成了"分隔"，比不画还糟。
                                     裹一层横向 StackPanel，它们要换一起换。

                                     **代价要记住**：水平 StackPanel 给子元素的可用宽度是无限，所以这一对
                                     放不下时不会换行，会被上层裁掉——WrapPanel 的「放不下就换行」保护在这
                                     两格上换成了「放不下就切掉」。目前安全是量出来的，不是想当然：18 种语言里
                                     这两个标签合计最长的是印尼语和俄语，而俄语在最窄的 760 宽下渲染出来仍留
                                     约 75px 余量（16%），印尼语只比它多 2%。**改这两个标签、或新增更长的语言
                                     时要回头量一次**（docs/manual-checks.md 里有对应的验收项）。
                                     竖线本身的用意：「以管理员身份」是「开机自启」的一种**方式**，不是第五个
                                     并列开关——"以管理员身份"后面根本没有宾语，只有挂在上一格下面才成句。
                                     运行时的从属（父项没勾就置灰）要等用户动手才看得见，第一眼看不出来。 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                    <CheckBox x:Name="StartupBox" Content="{loc:Loc Settings_Startup}" Margin="0,2,10,2"
                                              Checked="OnToggle" Unchecked="OnToggle"/>
                                    <Border x:Name="StartupTie" Width="1" Margin="0,4,10,4"/>
                                <!-- 提权自启（计划任务，一次 UAC）。跟在「开机自启」后面且只在它勾上时
                                     可用：它是自启的一种**方式**，不是一个独立的功能——没有自启却"以
                                     管理员身份自启"讲不通。真正的开/关逻辑在 OnToggle：UAC 被拒时要把
                                     这一格拨回真实状态，不能假装成功。 -->
                                    <CheckBox x:Name="ElevatedStartupBox" Content="{loc:Loc Settings_StartupElevated}"
                                              Margin="0,2,0,2" ToolTip="{loc:Loc Settings_StartupElevated_Tip}"
                                              Checked="OnToggle" Unchecked="OnToggle"/>
                                </StackPanel>
                            </WrapPanel>
                        </DockPanel>

                        <!-- 鼠标手势的代价常驻可见，不等到绑上了才提醒——低级鼠标钩子没有 RegisterHotKey
                             那种注册期冲突信号（§own-decision，见 mouse-hook-spike.md），事后提醒等于没提醒。
                             前面那个鼠标字形跟每张动作卡右侧的手势位是同一个记号，一眼能对上这段话在说谁。 -->
                        <DockPanel Margin="0,8,0,0">
                            <ContentControl x:Name="MouseCautionGlyph" Margin="1,2,7,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="MouseChordCaution" Text="{loc:Loc Settings_MouseChord_Caution}"
                                       FontSize="11.5" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ══ 动作 ════════════════════════════════════════════════════════
                     DockPanel 的填充元素：吃掉地图带和设置条之外的全部高度。 -->
                <DockPanel Margin="0,14,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock x:Name="ActionsTitle" Text="{loc:Loc Main_Actions}" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ActionsHint" Text="{loc:Loc Main_Actions_Hint}" FontSize="12"
                                   Margin="12,2,16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border x:Name="ActionsDivider" Height="1" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 「快捷键 / 鼠标手势」两列表头连同撑起它们的 SharedSizeGroup 一起去掉了：键位现在
                         就贴在动作名右边（上一版它们钉在 1140px 宽窗口的最右侧，离所属动作名有 700px 的
                         空白要跨），一个表头去解释三十厘米外的一列，本身就是那个距离的症状。 -->
                    <ScrollViewer x:Name="ActionsScroller" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <!-- VerticalAlignment=Top 不能省：内容比视口矮时 ScrollViewer 会把它拉伸到整个
                             视口高度，而 UniformGrid 是把拿到的高度按行数均分的——于是每张卡片被撑到
                             一百四十多像素，文字挤在顶上、下面空一大片，看起来像渲染坏了。顶对齐之后
                             卡片各自是自然高度，多出来的空白老老实实留在最后一行下面。 -->
                        <ItemsControl x:Name="ActionList" Focusable="False" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 列数由 OnActionsResized 按可用宽度切 1/2，经 MainWindow.ActionColumns
                                         这个依赖属性传进来——见那边的注释，直接在 SizeChanged 里顺视觉树
                                         去摸这个 UniformGrid 是有时序坑的。 -->
                                    <UniformGrid Columns="{Binding ActionColumns,
                                                     RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
