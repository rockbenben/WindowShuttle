<Window x:Class="WindowShuttle.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" SizeToContent="Manual">
    <!-- 一整块虚拟桌面大小的窗口，每块屏一个徽章，代码里按量出来的缩放比摆放（§round3）

         FlowDirection 钉死 LeftToRight，理由跟主窗口那块地图画布逐字相同：这不是文字，是显示器在
         桌面上的实物摆位。窗口那一级的 FlowDirection 是按语言设的（阿拉伯语就是 RightToLeft），
         而 Canvas.SetLeft 在 RTL 下从右边缘量起——三屏「2 1 3」会画成「3 1 2」，屏号跟桌上的实体机器
         正好对反，而"屏幕编号"这条动作的全部意义就是把两者对上。这里写的是**本地值**：本地值压过
         继承，所以这块画布不跟着窗口翻。上一轮只补了主窗口的地图，漏了这块同样的画布。 -->
    <Canvas x:Name="Root" FlowDirection="LeftToRight"/>
</Window>
