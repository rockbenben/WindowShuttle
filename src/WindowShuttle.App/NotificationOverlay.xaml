<Window x:Class="WindowShuttle.App.NotificationOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" SizeToContent="WidthAndHeight">
    <!-- 托盘气泡的替代品：一张卡片，落在鼠标所在那块屏工作区的底部居中（见 code-behind）。
         边框颜色按严重程度换（错误/可操作/提示三挡），文字本身照旧走 resx。round4：可操作那一档
         之前只靠琥珀色描边跟提示/错误两档区分——跟主窗口热键冲突态改之前的坑一模一样（那边加了
         个不掉色的"!"字形，见 MainWindow.Hotkeys.cs 的 §a11y 注释）。这里同理加一个不掉色也认得出
         的箭头字形（Chevron），只在可操作那一档显形，颜色照旧跟描边同一支琥珀色，但形状本身才是
         那条不依赖颜色的信号。 -->
    <!-- 底色/文字色/箭头色一律由 code-behind 从 AppTheme 取，XAML 里不留字面量——上一版写死的
         #E61E1E2E/#E9E9F2/#FFD166 是旧配色，主窗口换色之后这张卡就跟应用其余部分对不上了。 -->
    <Border x:Name="Card" CornerRadius="10" BorderThickness="1.4"
            Padding="17,13,17,13" MaxWidth="460">
        <DockPanel LastChildFill="True">
            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#8250;" FontWeight="Bold" FontSize="17"
                       Margin="12,0,1,1" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="Message" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
        </DockPanel>
    </Border>
</Window>
