<Project>
  <!-- Framework-dependent counterpart to win-x64.pubxml: same single-file win-x64 exe, but it
       expects the .NET 10 desktop runtime already on the machine instead of carrying its own copy.
       A few hundred KB instead of ~70+ MB, at the cost of one runtime-lookup/extraction step on
       every process start — see README's Download section for the actual trade-off. Publishes to
       its own directory so a `dotnet publish` with this profile can never overwrite the
       self-contained build's output (or vice versa) when both are produced back to back. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\Release\publish-needs-dotnet10\</PublishDir>
  </PropertyGroup>
</Project>
